<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Boo | Anna's AI Companion</title>

  <style>
    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: Arial, sans-serif;
      background: #111827;
      color: #f9fafb;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .app {
      width: 100%;
      max-width: 600px;
      height: 100vh;
      max-height: 850px;
      display: flex;
      flex-direction: column;
      background: #1f2937;
    }

    header {
      padding: 24px 20px;
      text-align: center;
      background: #111827;
      border-bottom: 1px solid #374151;
    }

    header h1 {
      margin: 0;
      font-size: 32px;
    }

    header p {
      margin: 8px 0 0;
      color: #cbd5e1;
    }

    #chat {
      flex: 1;
      overflow-y: auto;
      padding: 20px;
    }

    .message {
      margin-bottom: 16px;
      padding: 14px 16px;
      border-radius: 16px;
      line-height: 1.5;
      max-width: 88%;
    }

    .boo {
      background: #374151;
      margin-right: auto;
    }

    .anna {
      background: #4f46e5;
      margin-left: auto;
    }

    .input-area {
      display: flex;
      gap: 10px;
      padding: 14px;
      background: #111827;
      border-top: 1px solid #374151;
    }

    input {
      flex: 1;
      padding: 14px;
      border: none;
      border-radius: 12px;
      font-size: 16px;
      outline: none;
    }

    button {
      border: none;
      border-radius: 12px;
      padding: 0 20px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
    }

    button:hover {
      opacity: 0.9;
    }
  </style>
</head>

<body>

  <main class="app">

    <header>
      <h1>🐻 Boo</h1>
      <p>Protect curiosity. Reduce overwhelm.</p>
    </header>

    <section id="chat">
      <div class="message boo">
        Hey Anna. I'm Boo. 🐻<br><br>
        You can ask me questions, talk through ideas, learn something new,
        or just hang out and think things through.
        <br><br>
        You don't have to believe everything I say. Question me. Challenge me.
        Let's figure things out together.
      </div>
    </section>

    <div class="input-area">
      <input
        id="messageInput"
        type="text"
        placeholder="Talk to Boo..."
        autocomplete="off"
      >

      <button onclick="sendMessage()">Send</button>
    </div>

  </main>

  <script>
    function sendMessage() {
      const input = document.getElementById("messageInput");
      const chat = document.getElementById("chat");

      const message = input.value.trim();

      if (!message) return;

      const userMessage = document.createElement("div");
      userMessage.className = "message anna";
      userMessage.textContent = message;

      chat.appendChild(userMessage);

      input.value = "";

      const booMessage = document.createElement("div");
      booMessage.className = "message boo";
      booMessage.textContent =
        "I'm listening. The AI brain isn't connected yet, but this is where we'll build it.";

      chat.appendChild(booMessage);

      chat.scrollTop = chat.scrollHeight;
    }

    document.getElementById("messageInput").addEventListener("keydown", function(event) {
      if (event.key === "Enter") {
        sendMessage();
      }
    });
  </script>

</body>
</html>
